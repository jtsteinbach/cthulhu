{
  "name": "k8s_audit",
  "description": "Kubernetes API server audit log (JSON lines)",
  "paths": [
    "/var/log/kubernetes/audit.log"
  ],
  "format": "json",
  "category": "audit",
  "timestamp_field": "requestReceivedTimestamp",
  "field_map": {
    "verb": "action",
    "userAgent": "user_agent",
    "sourceIPs": "remote_ip"
  },
  "static": {
    "source": "k8s_audit"
  }
}
